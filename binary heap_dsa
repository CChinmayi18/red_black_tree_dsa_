        "\n",
        "import time\n",
        "import random\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 1. BINARY MIN HEAP\n",
        "# ==========================================\n",
        "\n",
        "class BinaryMinHeap:\n",
        "\n",
        "    def __init__(self):\n",
        "        self.heap = []\n",
        "\n",
        "    def insert(self, key):\n",
        "        self.heap.append(key)\n",
        "        i = len(self.heap) - 1\n",
        "\n",
        "        # Move the new element upwards\n",
        "        while i > 0:\n",
        "            parent = (i - 1) // 2\n",
        "\n",
        "            if self.heap[i] < self.heap[parent]:\n",
        "                self.heap[i], self.heap[parent] = (\n",
        "                    self.heap[parent], self.heap[i]\n",
        "                )\n",
        "                i = parent\n",
        "            else:\n",
        "                break\n",
        "\n",
        "    def extract_min(self):\n",
        "        if not self.heap:\n",
        "            raise IndexError(\"Heap is empty\")\n",
        "\n",
        "        minimum = self.heap[0]\n",
        "        last = self.heap.pop()\n",
        "\n",
        "        if self.heap:\n",
        "            self.heap[0] = last\n",
        "            self._heapify(0)\n",
        "\n",
        "        return minimum\n",
        "\n",
        "    def _heapify(self, i):\n",
        "        n = len(self.heap)\n",
        "\n",
        "        while True:\n",
        "            smallest = i\n",
        "            left = 2 * i + 1\n",
        "            right = 2 * i + 2\n",
        "\n",
        "            if left < n and self.heap[left] < self.heap[smallest]:\n",
        "                smallest = left\n",
        "\n",
        "            if right < n and self.heap[right] < self.heap[smallest]:\n",
        "                smallest = right\n",
        "\n",
        "            if smallest == i:\n",
        "                break\n",
        "\n",
        "            self.heap[i], self.heap[smallest] = (\n",
        "                self.heap[smallest], self.heap[i]\n",
        "            )\n",
        "\n",
        "            i = smallest\n",
        "\n",
        "    def peek(self):\n",
        "        if not self.heap:\n",
        "            raise IndexError(\"Heap is empty\")\n",
        "        return self.heap[0]\n",
        "\n",
        "    def display(self):\n",
        "        print(\"Binary Heap:\", self.heap)\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. BINOMIAL HEAP\n",
        "# ==========================================\n",
        "\n",
        "class BinomialNode:\n",
        "\n",
        "    def __init__(self, key):\n",
        "        self.key = key\n",
        "        self.degree = 0\n",
        "        self.parent = None\n",
        "        self.child = None\n",
        "        self.sibling = None\n",
        "\n",
        "\n",
        "class BinomialHeap:\n",
        "\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "        self.size = 0\n",
        "\n",
        "    # Merge two root lists in increasing degree order\n",
        "    def _merge(self, h1, h2):\n",
        "\n",
        "        if h1 is None:\n",
        "            return h2\n",
        "\n",
        "        if h2 is None:\n",
        "            return h1\n",
        "\n",
        "        dummy = BinomialNode(0)\n",
        "        tail = dummy\n",
        "\n",
        "        while h1 and h2:\n",
        "            if h1.degree <= h2.degree:\n",
        "                tail.sibling = h1\n",
        "                h1 = h1.sibling\n",
        "            else:\n",
        "                tail.sibling = h2\n",
        "                h2 = h2.sibling\n",
        "\n",
        "            tail = tail.sibling\n",
        "\n",
        "        tail.sibling = h1 if h1 else h2\n",
        "\n",
        "        return dummy.sibling\n",
        "\n",
        "    # Make one binomial tree a child of another\n",
        "    def _link(self, y, z):\n",
        "\n",
        "        y.parent = z\n",
        "        y.sibling = z.child\n",
        "        z.child = y\n",
        "        z.degree += 1\n",
        "\n",
        "    # Combine binomial trees of equal degree\n",
        "    def _union(self, other_head):\n",
        "\n",
        "        self.head = self._merge(self.head, other_head)\n",
        "\n",
        "        if self.head is None:\n",
        "            return\n",
        "\n",
        "        prev = None\n",
        "        curr = self.head\n",
        "        next_node = curr.sibling\n",
        "\n",
        "        while next_node is not None:\n",
        "\n",
        "            if (\n",
        "                curr.degree != next_node.degree\n",
        "                or (\n",
        "                    next_node.sibling is not None\n",
        "                    and next_node.sibling.degree == curr.degree\n",
        "                )\n",
        "            ):\n",
        "                prev = curr\n",
        "                curr = next_node\n",
        "\n",
        "            elif curr.key <= next_node.key:\n",
        "\n",
        "                curr.sibling = next_node.sibling\n",
        "                self._link(next_node, curr)\n",
        "\n",
        "            else:\n",
        "\n",
        "                if prev is None:\n",
        "                    self.head = next_node\n",
        "                else:\n",
        "                    prev.sibling = next_node\n",
        "\n",
        "                self._link(curr, next_node)\n",
        "                curr = next_node\n",
        "\n",
        "            next_node = curr.sibling\n",
        "\n",
        "    # Insert an element\n",
        "    def insert(self, key):\n",
        "\n",
        "        new_node = BinomialNode(key)\n",
        "\n",
        "        self._union(new_node)\n",
        "        self.size += 1\n",
        "\n",
        "    # Find the minimum element\n",
        "    def peek(self):\n",
        "\n",
        "        if self.head is None:\n",
        "            raise IndexError(\"Heap is empty\")\n",
        "\n",
        "        minimum = float('inf')\n",
        "        curr = self.head\n",
        "\n",
        "        while curr:\n",
        "            minimum = min(minimum, curr.key)\n",
        "            curr = curr.sibling\n",
        "\n",
        "        return minimum\n",
        "\n",
        "    # Remove and return the minimum element\n",
        "    def extract_min(self):\n",
        "\n",
        "        if self.head is None:\n",
        "            raise IndexError(\"Heap is empty\")\n",
        "\n",
        "        min_node = self.head\n",
        "        min_prev = None\n",
        "\n",
        "        prev = None\n",
        "        curr = self.head\n",
        "\n",
        "        while curr:\n",
        "\n",
        "            if curr.key < min_node.key:\n",
        "                min_node = curr\n",
        "                min_prev = prev\n",
        "\n",
        "            prev = curr\n",
        "            curr = curr.sibling\n",
        "\n",
        "        # Remove minimum root from root list\n",
        "        if min_prev is None:\n",
        "            self.head = min_node.sibling\n",
        "        else:\n",
        "            min_prev.sibling = min_node.sibling\n",
        "\n",
        "        # Reverse the child list\n",
        "        child = min_node.child\n",
        "        reversed_children = None\n",
        "\n",
        "        while child:\n",
        "            next_child = child.sibling\n",
        "            child.sibling = reversed_children\n",
        "            child.parent = None\n",
        "            reversed_children = child\n",
        "            child = next_child\n",
        "\n",
        "        min_node.parent = None\n",
        "        min_node.child = None\n",
        "        min_node.sibling = None\n",
        "\n",
        "        # Merge the remaining heap with reversed children\n",
        "        self._union(reversed_children)\n",
        "\n",
        "        self.size -= 1\n",
        "\n",
        "        return min_node.key\n",
        "\n",
        "    def display(self):\n",
        "\n",
        "        print(\"Binomial Heap (root nodes):\", end=\" \")\n",
        "\n",
        "        curr = self.head\n",
        "\n",
        "        while curr:\n",
        "            print(\n",
        "                f\"[Key={curr.key}, Degree={curr.degree}]\",\n",
        "                end=\" \"\n",
        "            )\n",
        "            curr = curr.sibling\n",
        "\n",
        "        print()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 3. DEMONSTRATION\n",
        "# ==========================================\n",
        "\n",
        "print(\"========== BINARY MIN HEAP ==========\")\n",
        "\n",
        "binary = BinaryMinHeap()\n",
        "\n",
        "values = [20, 5, 15, 22, 9, 3, 12]\n",
        "\n",
        "for value in values:\n",
        "    binary.insert(value)\n",
        "\n",
        "binary.display()\n",
        "\n",
        "print(\"Minimum Element:\", binary.peek())\n",
        "print(\"Extracted Minimum:\", binary.extract_min())\n",
        "\n",
        "binary.display()\n",
        "\n",
        "\n",
        "print(\"\\n========== BINOMIAL HEAP ==========\")\n",
        "\n",
        "binomial = BinomialHeap()\n",
        "\n",
        "for value in values:\n",
        "    binomial.insert(value)\n",
        "\n",
        "binomial.display()\n",
        "\n",
        "print(\"Minimum Element:\", binomial.peek())\n",
        "print(\"Extracted Minimum:\", binomial.extract_min())\n",
        "\n",
        "binomial.display()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 4. PERFORMANCE ANALYSIS\n",
        "# ==========================================\n",
        "\n",
        "print(\"\\n========== PERFORMANCE ANALYSIS ==========\")\n",
        "\n",
        "n = 5000\n",
        "\n",
        "random.seed(42)\n",
        "data = [random.randint(1, 10000) for _ in range(n)]\n",
        "\n",
        "\n",
        "# Binary Heap Performance\n",
        "binary = BinaryMinHeap()\n",
        "\n",
        "start = time.perf_counter()\n",
        "\n",
        "for value in data:\n",
        "    binary.insert(value)\n",
        "\n",
        "while binary.heap:\n",
        "    binary.extract_min()\n",
        "\n",
        "binary_time = time.perf_counter() - start\n",
        "\n",
        "\n",
        "# Binomial Heap Performance\n",
        "binomial = BinomialHeap()\n",
        "\n",
        "start = time.perf_counter()\n",
        "\n",
        "for value in data:\n",
        "    binomial.insert(value)\n",
        "\n",
        "while binomial.size > 0:\n",
        "    binomial.extract_min()\n",
        "\n",
        "binomial_time = time.perf_counter() - start\n",
        "\n",
        "\n",
        "print(\"Number of elements:\", n)\n",
        "print(\"Binary Heap Time:\", round(binary_time, 6), \"seconds\")\n",
        "print(\"Binomial Heap Time:\", round(binomial_time, 6), \"seconds\")\n",
        "\n",
        "if binary_time < binomial_time:\n",
        "    print(\"Binary Heap was faster in this experiment.\")\n",
        "elif binomial_time < binary_time:\n",
        "    print(\"Binomial Heap was faster in this experiment.\")\n",
        "else:\n",
        "    print(\"Both heaps took approximately equal time.\")\n",
        "\n",
        "\n",
        "print(\"\\n========== PROGRAM COMPLETED SUCCESSFULLY ==========\")\n"
      ]
